{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RimWorld Mod Library",
  "mainBinaryName": "RimWorld Mod Library",
  "version": "../package.json",
  "identifier": "io.github.lvkxz.rimworldmodlibrary",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "npm run vendor",
    "beforeBuildCommand": "npm run vendor"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' https: data: asset: http://asset.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "lvkxz",
    "copyright": "Copyright © 2026 lvkxz. All rights reserved.",
    "category": "Utility",
    "licenseFile": "../LICENSE",
    "shortDescription": "Mod library for RimWorld with Steam Workshop integration",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
